# Use your provider endpoints. Never commit real keys.
RPC_HTTP_URL=https://your-robinhood-mainnet-provider
ENRICHMENT_RPC_HTTP_URL=https://optional-separate-read-provider
MARKET_RPC_HTTP_URL=https://robinhood-rpc.publicnode.com
# Optional: HTTP polling/backfill works without WebSocket.
RPC_WS_URL=wss://your-robinhood-mainnet-provider
STREAM_RPC_HTTP_URL=https://optional-lightweight-head-provider
# Hard cap for enrichment reads (contract calls + selected transaction senders).
ENRICHMENT_DAILY_RPC_BUDGET=250
# Optional real-time Telegram delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional but recommended: normalized token identity from GMGN OpenAPI.
GMGN_API_KEY=
